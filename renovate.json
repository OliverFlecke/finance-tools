{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"platformAutomerge": true,
	"rebaseWhen": "behind-base-branch",
	"postUpdateOptions": ["pnpmDedupe"],
	"lockFileMaintenance": { "enabled": true, "automerge": true },
	"customManagers": [
		{
			"customType": "regex",
			"description": "keep hk.pkl amends/import versions in sync with the hk release",
			"managerFilePatterns": ["/(^|/)hk\\.pkl$/"],
			"matchStrings": [
				"download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@",
				"/hk@(?<currentValue>\\d+\\.\\d+\\.\\d+)#"
			],
			"depNameTemplate": "jdx/hk",
			"datasourceTemplate": "github-releases"
		}
	],
	"prConcurrentLimit": 5,
	"prHourlyLimit": 0,
	"minimumReleaseAge": "1 day",
	"packageRules": [
		{
			"description": "automerge everything except major once checks pass",
			"matchUpdateTypes": ["minor", "patch", "pin", "digest"],
			"automerge": true
		},
		{
			"description": "group mise tool bumps",
			"matchManagers": ["mise"],
			"groupName": "mise tools"
		},
		{
			"description": "bump hk in mise.toml and hk.pkl together",
			"matchPackageNames": ["jdx/hk", "hk"],
			"groupName": "hk"
		},
		{
			"description": "npm (frontend): group production minor/patch updates into one PR",
			"matchManagers": ["npm"],
			"matchFileNames": ["frontend/**"],
			"matchDepTypes": ["dependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "frontend production dependencies (non-major)"
		},
		{
			"description": "npm (frontend): group devDependencies minor/patch updates into one PR",
			"matchManagers": ["npm"],
			"matchFileNames": ["frontend/**"],
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "frontend devDependencies (non-major)"
		},
		{
			"description": "npm (finance-api): group production minor/patch updates into one PR",
			"matchManagers": ["npm"],
			"matchFileNames": ["finance-api/**"],
			"matchDepTypes": ["dependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "finance-api production dependencies (non-major)"
		},
		{
			"description": "npm (finance-api): group devDependencies minor/patch updates into one PR",
			"matchManagers": ["npm"],
			"matchFileNames": ["finance-api/**"],
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "finance-api devDependencies (non-major)"
		},
		{
			"description": "cargo (finance-api): group all minor/patch updates into one PR (Renovate's cargo manager doesn't distinguish prod vs dev dependencies)",
			"matchManagers": ["cargo"],
			"matchFileNames": ["finance-api/**"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "finance-api cargo dependencies (non-major)"
		},
		{
			"description": "npm: wait 2 days before raising non-major update PRs",
			"matchManagers": ["npm"],
			"matchUpdateTypes": ["patch", "minor"],
			"minimumReleaseAge": "2 days"
		},
		{
			"description": "npm: wait 7 days before raising major update PRs",
			"matchManagers": ["npm"],
			"matchUpdateTypes": ["major"],
			"minimumReleaseAge": "7 days"
		},
		{
			"description": "frontend: never raise major TypeScript updates",
			"matchFileNames": ["frontend/**"],
			"matchPackageNames": ["typescript"],
			"matchUpdateTypes": ["major"],
			"enabled": false
		},
		{
			"description": "frontend: never raise major Tailwind CSS updates",
			"matchFileNames": ["frontend/**"],
			"matchPackageNames": ["tailwindcss"],
			"matchUpdateTypes": ["major"],
			"enabled": false
		}
	]
}
