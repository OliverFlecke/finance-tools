{
	"name": "finance-tools",
	"version": "0.1.0",
	"private": false,
	"license": "MIT",
	"homepage": "https://finance.oliverflecke.me",
	"engines": {
		"node": "^26"
	},
	"scripts": {
		"start-server": "pnpm build && pnpm start",
		"dev": "next dev --experimental-https --turbo",
		"dev:https": "node server.js",
		"lint": "biome lint --write",
		"fmt": "biome format --write",
		"start": "next start",
		"build": "next build",
		"test": "jest --watch",
		"build:api:spec": "cargo run --manifest-path ../finance-api/Cargo.toml --features openapi openapi > ./openapi.json",
		"build:api:client": "openapi-ts",
		"build:api": "pnpm build:api:spec && pnpm build:api:client",
		"deploy": "pnpm run build && wrangler deploy",
		"preview": "pnpm run build && wrangler dev"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.101.4",
		"@visx/axis": "^4.0.0",
		"@visx/curve": "^4.0.0",
		"@visx/group": "^4.0.0",
		"@visx/legend": "^4.0.0",
		"@visx/responsive": "^4.0.0",
		"@visx/scale": "^4.0.0",
		"@visx/shape": "^4.0.0",
		"@visx/xychart": "^4.0.0",
		"clsx": "^2.1.1",
		"d3-array": "^3.2.4",
		"immutability-helper": "^3.1.1",
		"lucide-react": "^1.52.0",
		"next": "16.4.0",
		"oidc-client-ts": "^3.5.0",
		"react": "19.3.0",
		"react-dnd": "^16.0.1",
		"react-dnd-html5-backend": "^16.0.1",
		"react-dom": "19.3.0",
		"react-hook-form": "^7.84.0",
		"react-number-format": "^5.4.5",
		"react-oidc-context": "^3.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@css-modules-kit/ts-plugin": "^1.4.0",
		"@hey-api/openapi-ts": "^0.99.0",
		"@types/d3-array": "^3.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/file-saver": "^2.0.3",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"cypress": "^16.1.1",
		"jest": "^30.5.2",
		"typescript": "^5.9.3"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
